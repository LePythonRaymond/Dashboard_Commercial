# Copy this file to /opt/myrium/dashboard.env on the VPS and fill in the real values.
# DO NOT commit the real dashboard.env. It is in .gitignore.

# ---- Auth ---------------------------------------------------------------
DASHBOARD_PASSWORD=Raymond-2026

# ---- Traefik routing (read by docker-compose, not by the app) -----------
DASHBOARD_HOST=dashboard-commercial.srv1082911.hstgr.cloud
TRAEFIK_NETWORK=replace-with-output-of-discovery-step
TRAEFIK_CERT_RESOLVER=replace-with-resolver-name
TRAEFIK_ENTRYPOINT=websecure

# ---- Shared volumes (must match the cron pipeline paths) ----------------
DATA_DIR=/opt/myrium-data
LOG_DIR=/opt/myrium-logs

# ---- Furious + Google Sheets (same values as the cron pipeline) ---------
FURIOUS_API_KEY=
FURIOUS_API_USER=
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=/app/config/credentials/service_account.json

# ---- Notion (optional) --------------------------------------------------
NOTION_API_KEY=
NOTION_MAINTENANCE_DATASOURCE_ID=

# ---- Budget export (optional) -------------------------------------------
# Drive folder ID where the "Générer budget {année}" button uploads the
# generated .xlsx as a native Google Sheet. Get it from the URL of the
# Drive folder you want to use, e.g. https://drive.google.com/drive/folders/<THIS_PART>
# Folder must be shared (at least "Editor") with the service account email.
BUDGET_EXPORT_DRIVE_FOLDER_ID=
